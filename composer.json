{
  "name": "michalskoula/console",
  "description": "Simple PHP library for creating command-line applications",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Muhammad Syifa",
      "email": "emsifa@gmail.com"
    },
    {
      "name": "Michal Skoula",
      "email": "michal@skoula.cz"
    }
  ],
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "symplify/easy-coding-standard": "^13.3",
    "rector/rector": "^2.6"
  },
  "autoload": {
    "psr-4": {
      "MichalSkoula\\Console\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MichalSkoula\\Console\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "phpunit",
    "ecs": "ecs check",
    "ecs:fix": "ecs check --fix",
    "rector": "rector process --dry-run",
    "rector:fix": "rector process",
    "check": [
      "@test",
      "@ecs",
      "@rector"
    ]
  }
}
